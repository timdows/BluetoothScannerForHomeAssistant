[Unit]
Description=Chipolo scanner for Home Assistant
After=bluetooth.target network-online.target
Wants=bluetooth.target network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/BluetoothScannerForHomeAssistant
ExecStart=/home/pi/BluetoothScannerForHomeAssistant/venv/bin/python chipolo_scanner.py --plain
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
